# Replace api.example.com and certificate paths before enabling.
# Cloudflare sits in front of this server. Without the real client IP, every limit below
# and the API's own rate limits would count all visitors as a few Cloudflare addresses.
# deploy/README.md shows how to generate this file.
include /etc/nginx/snippets/cloudflare-real-ip.conf;
real_ip_header CF-Connecting-IP;
limit_req_zone $binary_remote_addr zone=ecobud_api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=ecobud_connections:10m;
# Reuse connections to the API instead of opening one per request.
upstream ecobud_api_upstream {
    server 127.0.0.1:3000;
    keepalive 32;
}
# Requests for any other host name get no response and no default nginx page.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    server_tokens off;
    ssl_reject_handshake on;
    return 444;
}
server {
    listen 80;
    server_name api.example.com;
    server_tokens off;
    return 301 https://api.example.com$request_uri;
}
server {
    listen 443 ssl http2;
    server_name api.example.com;
    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 51m;
    client_body_timeout 20s;
    limit_req_status 429;
    limit_conn_status 429;
    location / {
        limit_req zone=ecobud_api burst=30 nodelay;
        limit_conn ecobud_connections 20;
        proxy_pass http://ecobud_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite forwarded headers; this is the only trusted ingress proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 130s;
        proxy_send_timeout 30s;
    }
}
