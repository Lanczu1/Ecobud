generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                @id @default(cuid())
  name                         String
  email                        String                @unique
  passwordHash                 String                @map("password")
  role                         UserRole              @default(user)
  status                       UserStatus            @default(pending)
  points                       Int                   @default(0)
  currentStreak                Int                   @default(0) @map("streak_count")
  lastActionDate               DateTime?             @map("last_action_date")
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")
  reviewedChallengeSubmissions ChallengeSubmission[] @relation("ModeratedChallengeSubmissions")
  challengeSubmissions         ChallengeSubmission[] @relation("SubmittedChallengeProofs")
  managedEvents                Event[]               @relation("ManagedEvents")
  eventRegistrations           EventRegistration[]
  habitCheckIns                HabitCheckIn[]
  profile                      Profile?
  updatedSettings              SystemSetting[]       @relation("SystemSettingUpdates")
  transparencyLogs             TransparencyLog[]
  badges                       UserBadge[]
  challengeProgress            UserChallenge[]
  auditLogs                    AuditLog[]
  lessonProgress               UserLessonProgress[]
  authoredLessons              Lesson[]              @relation("LessonAuthor")
  presenceSessions             PresenceSession[]
  stats                        UserStats?
  weeklyGoal                   UserWeeklyGoal?
  eventSubmissions             EventSubmission[]
  rewardTransactions           RewardTransaction[]
  notifications                Notification[]
  giveAndGetItems              GiveAndGetItem[]
  swapListings                 SwapListing[]
  swapRequestsSent            SwapRequest[] @relation("SwapRequestFrom")
  swapRequestsReceived        SwapRequest[] @relation("SwapRequestTo")

  @@map("users")
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  displayName     String
  avatarUrl       String?
  headline        String?
  city            String?
  preferencesJson String?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lesson {
  id               String               @id @default(cuid())
  title            String
  description      String
  content          String
  category         String
  imageUrl         String?
  durationMinutes  Int                  @default(0)
  rating           Float                @default(4.8)
  pointsReward     Int                  @default(10)
  ecoCoinsReward   Int                  @default(5) @map("eco_coins_reward")
  featured         Boolean              @default(false)
  isPublished      Boolean              @default(false) @map("is_published")
  scheduledAt      DateTime?            @map("scheduled_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  createdById      String?              @map("created_by_id")
  quizPassingScore Int                  @default(70) @map("quiz_passing_score")
  transcript       String?
  videoUrl         String?
  difficulty       String               @default("Beginner")
  pages            LessonPage[]
  progress         UserLessonProgress[]
  createdBy        User?                @relation("LessonAuthor", fields: [createdById], references: [id])
  quizQuestions    QuizQuestion[]

  @@map("lessons")
}

model LessonPage {
  id          String   @id @default(cuid())
  lessonId    String   @map("lesson_id")
  title       String
  description String
  content     String
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_pages")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  lessonId      String   @map("lesson_id")
  question      String
  optionA       String   @map("option_a")
  optionB       String   @map("option_b")
  optionC       String   @map("option_c")
  optionD       String   @map("option_d")
  correctAnswer String   @map("correct_answer")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model UserLessonProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  lessonId       String    @map("lesson_id")
  status         String    @default("not_started")
  progress       Int       @default(0)
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  videoTimestamp Float     @default(0) @map("video_timestamp")
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model UserStats {
  userId          String   @id @map("user_id")
  currentStreak   Int      @default(0) @map("current_streak")
  ecoPoints       Int      @default(0) @map("eco_points")
  ecoCoins        Int      @default(0) @map("eco_coins")
  knowledgePoints Int      @default(0) @map("knowledge_points")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserWeeklyGoal {
  userId     String   @id @map("user_id")
  weeklyGoal Int      @default(5) @map("weekly_goal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_weekly_goal")
}

model Challenge {
  id                  String                @id @default(cuid())
  title               String
  description         String
  difficulty          String
  category            String?
  endDate             DateTime?
  imageUrl            String?
  badgeLabel          String?
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ecoCoinReward       Int                   @default(0)
  expReward           Int                   @default(0)
  aiDetectionTargets  String[]
  aiMinimumConfidence Int?                  @default(80)
  type                String                @default("GENERAL")
  isFeatured          Boolean               @default(false)
  submissions         ChallengeSubmission[]
  userChallenges      UserChallenge[]
}

model UserChallenge {
  id                 String    @id @default(cuid())
  userId             String
  challengeId        String
  progressPercentage Int       @default(0)
  status             String    @default("IN_PROGRESS")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  expirationDate     DateTime?
  challenge          Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model ChallengeSubmission {
  id             String                    @id @default(cuid())
  userId         String
  challengeId    String
  proofText      String?
  proofUrl       String?
  afterProofUrl  String?
  status         ChallengeSubmissionStatus @default(pending)
  moderatorNotes String?
  flaggedReason  String?
  reviewedById   String?                   @map("reviewed_by_id")
  reviewedAt     DateTime?                 @map("reviewed_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  challenge      Challenge                 @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reviewer       User?                     @relation("ModeratedChallengeSubmissions", fields: [reviewedById], references: [id])
  user           User                      @relation("SubmittedChallengeProofs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model Habit {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  pointsReward Int
  active       Boolean        @default(true)
  checkIns     HabitCheckIn[]
}

model HabitCheckIn {
  id            String   @id @default(cuid())
  userId        String
  habitId       String
  dateKey       String
  pointsAwarded Int
  createdAt     DateTime @default(now())
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, dateKey])
}

model Badge {
  id             String      @id @default(cuid())
  name           String      @unique
  description    String
  iconUrl        String
  requiredPoints Int
  accentColor    String?
  users          UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Event {
  id              String              @id @default(cuid())
  title           String
  description     String
  location        String
  startDatetime   DateTime            @map("start_datetime")
  endDatetime     DateTime            @map("end_datetime")
  capacity        Int
  ecoCoinsReward  Int                 @default(0) @map("eco_coins_reward")
  expReward       Int                 @default(0) @map("exp_reward")
  managedById     String              @map("managed_by_id")
  imageUrl        String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  managedBy       User                @relation("ManagedEvents", fields: [managedById], references: [id], onDelete: Cascade)
  registrations   EventRegistration[]
  qrCodes         EventQrCode[]
  submissions     EventSubmission[]
  rewards         RewardTransaction[]
}

model EventRegistration {
  id           String    @id @default(cuid())
  userId       String
  eventId      String
  status       String    @default("REGISTERED")
  registeredAt DateTime  @default(now())
  attendedAt   DateTime?
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model EventQrCode {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  qrData      String   @map("qr_data")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_qr_codes")
}

model EventSubmission {
  id                   String                  @id @default(cuid())
  userId               String                  @map("user_id")
  eventId              String                  @map("event_id")
  attendanceImageUrl   String                  @map("attendance_image_url")
  qrVerified           Boolean                 @default(false) @map("qr_verified")
  status               EventSubmissionStatus   @default(pending)
  rejectionReason      String?                 @map("rejection_reason")
  submittedAt          DateTime                @default(now()) @map("submitted_at")
  reviewedAt           DateTime?               @map("reviewed_at")
  event                Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_submissions")
}

model RewardTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  eventId     String?  @map("event_id")
  type        RewardType
  amount      Int
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@map("reward_transactions")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model TransparencyLog {
  id            String   @id @default(cuid())
  userId        String
  actionType    String
  publicLabel   String
  pointsAwarded Int
  metadata      String?
  previousHash  String
  currentHash   String   @unique
  timestamp     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   User?    @relation("SystemSettingUpdates", fields: [updatedById], references: [id])
}

model PresenceSession {
  sessionId       String                  @id @map("session_id")
  userId          String                  @map("user_id")
  isOnline        Boolean                 @default(true) @map("is_online")
  connectedAt     DateTime                @default(now()) @map("connected_at") @db.Timestamptz(3)
  lastSeenAt      DateTime                @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  disconnectedAt  DateTime?               @map("disconnected_at") @db.Timestamptz(3)
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(3)
  appState        PresenceAppState        @default(active) @map("app_state")
  connectionState PresenceConnectionState @default(online) @map("connection_state")
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isOnline, expiresAt], map: "presence_sessions_online_expiry_idx")
  @@index([lastSeenAt], map: "presence_sessions_last_seen_idx")
  @@map("presence_sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  details   String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  user
  moderator
  admin
}

enum UserStatus {
  active
  pending
  suspended
}

enum ChallengeSubmissionStatus {
  pending
  approved
  rejected
  flagged
}

enum PresenceAppState {
  active
  background
  inactive
}

enum PresenceConnectionState {
  online
  offline
  reconnecting
  stale
}

enum EventSubmissionStatus {
  pending
  approved
  rejected
}

enum RewardType {
  eco_coins
  exp
}

model GiveAndGetItem {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  description String?
  category    String
  condition   String
  wantedFor   String?  @map("wanted_for")
  status      String   @default("Available")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("give_and_get_items")
}

model RedeemItem {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  coinCost    Int      @map("coin_cost")
  imageUrl    String?  @map("image_url")
  category    String   @default("general")
  stock       Int      @default(-1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("redeem_items")
}

model SwapListing {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  title          String
  category       String
  quantity       String
  condition      String
  description    String  @default("")
  lookingFor     String   @map("looking_for")
  images         Json     @default("[]")
  meetupMethod   String   @map("meetup_method")
  meetupLocation String?  @map("meetup_location")
  meetupLandmark String?  @map("meetup_landmark")
  meetupNotes    String?  @map("meetup_notes")
  city           String?
  province       String?
  latitude       Float?
  longitude      Float?
  distanceKm     Float?   @map("distance_km")
  isActive       Boolean  @default(true) @map("is_active")
  approvalStatus String   @default("pending") @map("approval_status")
  reportCount    Int      @default(0) @map("report_count")
  isReported     Boolean  @default(false) @map("is_reported")
  reportReason   String?  @map("report_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       SwapRequest[]
  conversations  SwapConversation[]

  @@index([userId])
  @@index([category])
  @@index([isActive, createdAt])
  @@index([approvalStatus])
  @@map("swap_listings")
}

model SwapRequest {
  id          String   @id @default(cuid())
  listingId   String   @map("listing_id")
  fromUserId  String   @map("from_user_id")
  toUserId    String   @map("to_user_id")
  status      String   @default("pending")
  message     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  listing     SwapListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUser    User     @relation("SwapRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("SwapRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  conversation SwapConversation?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([listingId])
  @@map("swap_requests")
}

model SwapConversation {
  id              String   @id @default(cuid())
  swapRequestId   String   @unique @map("swap_request_id")
  listingId       String   @map("listing_id")
  user1Id         String   @map("user1_id")
  user2Id         String   @map("user2_id")
  status          String   @default("pending")
  unreadCount     Int      @default(0) @map("unread_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  swapRequest     SwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  listing         SwapListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages        SwapMessage[]

  @@index([user1Id])
  @@index([user2Id])
  @@map("swap_conversations")
}

model SwapMessage {
  id              String   @id @default(cuid())
  swapRequestId   String   @map("swap_request_id")
  senderId        String   @map("sender_id")
  text            String   @default("")
  imageUrl        String?  @map("image_url")
  timestamp       DateTime @default(now())
  read            Boolean  @default(false)
  delivered       Boolean  @default(true)
  conversation    SwapConversation @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)

  @@index([swapRequestId])
  @@index([senderId])
  @@map("swap_messages")
}

model RedeemRequest {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  itemId      String   @map("item_id")
  coinCost    Int      @map("coin_cost")
  status      String   @default("pending") // pending | approved | rejected | ready_to_claim | claimed
  rejectReason String? @map("reject_reason")
  userName    String   @default("") @map("user_name")
  itemTitle   String   @default("") @map("item_title")
  itemImage   String?  @map("item_image")
  claimCode       String?  @map("claim_code")
  claimLocation   String?  @map("claim_location")
  claimUntil      DateTime? @map("claim_until")
  claimInstructions String? @map("claim_instructions")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("redeem_requests")
}
