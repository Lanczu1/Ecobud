DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecobud?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ecobud?schema=public
JWT_SECRET=replace-with-a-strong-secret
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Production: use exact HTTPS frontend origins and a randomly generated JWT_SECRET.
# Set TRUST_PROXY only to the addresses/subnets of your actual reverse proxy.
TRUST_PROXY=
GMAIL_USER=
GMAIL_PASS=
# Demo seeding is destructive; never enable against a real database.
ALLOW_DEMO_SEED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_REALTIME_CHANNEL_SECRET=your-supabase-realtime-channel-secret
MISTRAL_API_KEY=your-mistral-api-key


# Server-only Gemini challenge image recognition. Never use EXPO_PUBLIC_ or VITE_ for this key.
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-3.6-flash"

# Notification delivery (in-app inbox + direct Firebase Cloud Messaging)
ECOBUD_WELCOME_URL=ecobud://
# Use one server-only credential source. Prefer a mounted secret path in production.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternatives: FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_SERVICE_ACCOUNT_BASE64
