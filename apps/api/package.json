{
  "name": "ecobud-api",
  "version": "1.1.9",
  "description": "ECOBUD Backend API",
  "main": "dist/index.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node scripts/start.cjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "measure": "node scripts/measure-latency.cjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "check:environment": "node scripts/check-environment.cjs",
    "check:release": "prisma validate && prisma generate && tsc --noEmit && npm audit --audit-level=moderate"
  },
  "overrides": {
    "qs": "^6.15.4",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-gax": {
      "rimraf": "^6.1.4"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
